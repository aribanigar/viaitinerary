# --- Supabase (PostgreSQL) via Prisma ---
# The schema reads APP_DATABASE_URL / APP_DIRECT_URL (not DATABASE_URL) so a host's
# own DATABASE_URL can't override the app's connection.
# Always use the POOLER host (aws-*.pooler.supabase.com) — the direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from IPv4 serverless
# platforms like Vercel. Port 6543 (?pgbouncer=true) for the app, 5432 for migrations.
APP_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
APP_DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Secret used to sign session JWTs. Use a long random string (openssl rand -hex 32).
JWT_SECRET="change-me-to-a-long-random-string"

# --- Optional: Razorpay (subscriptions/payments) ---
# Leave blank to run without payments (create-order returns 503).
RAZORPAY_KEY=""
RAZORPAY_SECRET=""

# --- Optional: Supabase Storage (image uploads) ---
# Set the service_role key to store images in a public bucket; else images stay
# inline as data URLs.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# --- Optional: platform SMTP (OTP, password reset, fallback sender) ---
# Agencies can also set their own SMTP in Settings; this is the global fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="ViaItinerary"

# --- Optional: Pixabay (destination photo search) ---
# Used server-side only by /api/destinations/photos so the key never reaches the browser.
# Get a free key at https://pixabay.com/api/docs/. Leave blank to disable photo search.
PIXABAY_API_KEY=""

# --- Optional: Via Kashmir B2B rate portal (hotel catalog import) ---
# Public feed, no key needed. Override only to point at a different deploy.
B2B_VIAKASHMIR_URL="https://b2b.viakashmiritinerary.in"

# --- Optional: account import (Settings -> Import Account) ---
# The travel-agency app's API an owner imports their data from. Default below.
TRAVEL_AGENCY_API_URL="https://viakashmiritinerary.in/api"
# Platform alert address for public enquiry emails (default: the super admin's email).
ADMIN_ALERT_EMAIL=""

# --- Optional: lead-source integrations (Integrations page) ---
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI=""
META_VERIFY_TOKEN=""
META_INCLUDE_EMAIL=""
META_INCLUDE_PAGES_SCOPES=""
META_INCLUDE_LEADS_RETRIEVAL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
FRONTEND_URL=""
# Protects /api/cron/sync-b2b-hotels (openssl rand -hex 24). Vercel Cron sends
# it automatically once set as a project env var; leave blank to leave the
# route open to anyone who finds it.
CRON_SECRET=""
